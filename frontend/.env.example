# --- Backend wiring (dev) -----------------------------------------------
# The Vite dev server proxies /api and /health to the FastAPI backend and
# /s3 to MinIO, so the browser only ever talks to ONE origin (no CORS, no
# mixed-content errors, works from a phone on the same Wi-Fi).
DEV_API_TARGET=http://localhost:8000
DEV_S3_TARGET=http://localhost:9000

# Host the backend puts inside presigned URLs (S3_ENDPOINT_URL in docker-compose).
VITE_S3_ORIGIN=http://minio:9000

# --- Production -----------------------------------------------------------
# Leave empty to use same-origin /api (behind a reverse proxy), or set the
# absolute API URL. Set VITE_S3_PROXY=false when using real S3 / a public
# MinIO URL that has CORS enabled.
VITE_API_URL=
VITE_S3_PROXY=true

# --- Demo / offline UI work (no GPU backend needed) ------------------------
# `npm run dev:mock` turns this on. Put any .splat in public/demo/ and point here.
VITE_USE_MOCK=false
VITE_DEMO_SPLAT_URL=/demo/room.splat
