DATABASE_URL=postgresql+psycopg://roomsage:roomsage@localhost:5432/roomsage
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://localhost:5173"]
S3_BUCKET=roomsage
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Set this to a MinIO endpoint for local S3-compatible storage.
S3_ENDPOINT_URL=
UPLOAD_MAX_BYTES=26214400
S3_PRESIGNED_URL_EXPIRATION=3600
JOB_STATE_TTL_SECONDS=86400
PIPELINE_ESTIMATED_SECONDS=1800
# Absolute path to the TripoSR run.py script inside the GPU worker container.
TRIPOSR_RUN_SCRIPT=
EDIT_ASSET_GAUSSIAN_COUNT=10000
# Optional SAM instance masks for Gaussian-to-object labels.
SAM_ENABLED=false
SAM_CHECKPOINT_PATH=
SAM_MODEL_TYPE=vit_b
SAM_MAX_KEYFRAMES=8
SAM_MAX_MASKS_PER_KEYFRAME=128
