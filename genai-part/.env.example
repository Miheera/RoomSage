# Copy to .env. Every value below is the default unless noted.
CORS_ORIGINS=["http://localhost:5173"]

# Adds data/furniture/demo_products.json to the catalog (see scripts/seed_demo_data.py).
DEMO_CATALOG=false

# offline | anthropic | openai_compatible
LLM_PROVIDER=offline
# For openai_compatible, use the provider's model name, e.g. llama3.2 on Ollama.
LLM_MODEL=claude-opus-5-5
LLM_API_KEY=
# Required for openai_compatible, e.g. http://localhost:11434/v1 for Ollama.
LLM_BASE_URL=

# mock | diffusion (diffusion needs requirements-gpu.txt)
REDESIGN_MODE=mock
REDESIGN_DEVICE=cuda
REDESIGN_MAX_SIDE=512
REDESIGN_STEPS=25

# mock | live. Live sends real requests to Person A's service.
PERSON_A_MODE=mock
PERSON_A_BASE_URL=http://localhost:8000
